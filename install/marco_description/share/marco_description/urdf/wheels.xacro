<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Diferansiyel suruş: 2 tahrik tekeri + 4 sarhos teker.
    Tahrik tekerleri base_link ile ayni yukseklikte (aks hizasinda) durur.

    Sarhos tekerler burada tek serbestlik dereceli donen silindir olarak degil,
    surtunmesiz kure olarak modellenmistir. Gercek mekanizma cift merkezli ve
    kendi etrafinda donuyor; ancak lokalizasyon ve navigasyon acisindan onemli
    olan tek sey temas noktasi ve tasidigi yuk oldugundan bu basitlestirme
    odometri dogrulugunu etkilemez ve sim cozucusunu belirgin olcude hizlandirir.
  -->

  <xacro:macro name="drive_wheel" params="prefix reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="${max_wheel_speed / wheel_radius}"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="marco_rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
    </link>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <xacro:macro name="caster" params="prefix x y">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_caster_link"/>
      <origin xyz="${x} ${y} ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="marco_dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>
  </xacro:macro>

  <xacro:caster prefix="front_left"  x="${caster_x_front}" y="${ caster_y}"/>
  <xacro:caster prefix="front_right" x="${caster_x_front}" y="${-caster_y}"/>
  <xacro:caster prefix="rear_left"   x="${caster_x_rear}"  y="${ caster_y}"/>
  <xacro:caster prefix="rear_right"  x="${caster_x_rear}"  y="${-caster_y}"/>

</robot>

Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /Odometry1
      Splitter Ratio: 0.5
    Tree Height: 640
Visualization Manager:
  Class: ""
  Displays:
    # Izgara odom cercevesine sabitlenir; robot uzerinde tasinmaz. Boylece
    # aracin gercekten yer degistirdigi gorulur. marco_description icindeki
    # model.rviz ise izgarayi robota baglar, cunku o yapilandirma odometri
    # olmadan yalnizca modeli incelemek icindir.
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 24
      Color: 160; 160; 164
      Line Style:
        Value: Lines
      Reference Frame: odom
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    # Odometri okunun izi, kat edilen yolu gosterir. Kalibrasyon sirasinda
    # kare parkurun kapanip kapanmadigi buradan gozle de anlasilir.
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Alpha: 0.8
        Color: 255; 170; 0
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
      Covariance:
        Value: false
    # Reliability Policy BURADA "Best Effort" OLMALI. YDLidar surucusu
    # sensor QoS ile yayinliyor; Reliable secilirse RViz tek nokta gostermez
    # ve hicbir hata da vermez.
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 0; 255; 100
      Position Transformer: XYZ
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Update Interval: 0
      Frame Timeout: 15
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 7.0
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.9
      Target Frame: odom
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false

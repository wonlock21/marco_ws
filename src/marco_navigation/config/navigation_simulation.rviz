Panels:
  - {Class: rviz_common/Displays, Name: Phase 6 Navigation Displays}
  - {Class: nav2_rviz_plugins/Navigation 2, Name: Navigation 2}
Visualization Manager:
  Class: ""
  Displays:
    - {Class: rviz_default_plugins/Grid, Name: Grid, Enabled: true, Cell Size: 1, Plane Cell Count: 30}
    - Class: rviz_default_plugins/Map
      Name: Simulation test Map
      Enabled: true
      Topic: {Value: /map, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.7
    - {Class: rviz_default_plugins/RobotModel, Name: RobotModel, Enabled: true, Description Topic: {Value: /robot_description}}
    - {Class: rviz_default_plugins/TF, Name: TF, Enabled: true, Show Axes: true, Marker Scale: 0.3}
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan /scan
      Enabled: true
      Topic: {Value: /scan, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Queue Size: 1
      Decay Time: 0
      Style: Points
      Size (Pixels): 3
      Color: 0; 255; 110
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose/covariance
      Enabled: true
      Topic: {Value: /amcl_pose, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles
      Enabled: true
      Topic: {Value: /particle_cloud, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic: {Value: /global_costmap/costmap, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.35
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic: {Value: /local_costmap/costmap, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.45
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic: {Value: /plan, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Color: 0; 255; 0
      Line Width: 0.05
    - Class: rviz_default_plugins/Path
      Name: Local/controller plan
      Enabled: true
      Topic: {Value: /local_plan, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Color: 255; 180; 0
      Line Width: 0.05
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic: {Value: /local_costmap/published_footprint, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Path
      Name: Ground-truth path
      Enabled: true
      Topic: {Value: /ground_truth/path, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Color: 0; 255; 255
      Line Width: 0.04
    - Class: rviz_default_plugins/Path
      Name: AMCL estimated path
      Enabled: true
      Topic: {Value: /amcl/path, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Color: 255; 0; 255
      Line Width: 0.04
  Global Options: {Background Color: 35; 38; 45, Fixed Frame: map, Frame Rate: 30}
  Tools:
    - {Class: rviz_default_plugins/Interact}
    - {Class: rviz_default_plugins/MoveCamera}
    - {Class: rviz_default_plugins/Select}
    - {Class: nav2_rviz_plugins/GoalTool, Topic: {Value: /goal_pose}}
    - {Class: rviz_default_plugins/SetInitialPose, Topic: {Value: /initialpose}}
  Views:
    Current: {Class: rviz_default_plugins/TopDownOrtho, Name: Navigation overview, Scale: 22}
Window Geometry: {Height: 900, Width: 1400}

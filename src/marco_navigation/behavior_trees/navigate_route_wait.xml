<!--
  MarCO Faz 7/12 — nav2_route ile tanimli rota aginda gezin.

  ComputeRoute ilk path'i senkron olarak uretir. Ardindan ComputeAndTrackRoute
  kenar takibi yapar ve AdjustSpeedLimit abs_speed_limit metadata'sini
  /speed_limit'e yazar; FollowPath ayni path'i RPP ile izler.

  Sartname: engelden kacinma YOK → recovery yalnizca Wait.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1000" name="NavigateRecovery">
      <Sequence name="RouteThenTrackAndFollow">
        <!-- FollowPath bos path ile baslamasin; zamanlamaya dayali Wait kullanma. -->
        <ComputeRoute
            goal="{goal}"
            path="{path}"
            route="{route}"
            use_poses="true"/>
        <Parallel success_threshold="2" failure_threshold="1" name="TrackAndFollow">
          <ComputeAndTrackRoute
              goal="{goal}"
              path="{path}"
              route="{route}"
              use_poses="true"
              current_edge_id="{current_edge_id}"/>
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <FollowPath path="{path}" controller_id="FollowPath"/>
            <Sequence name="ClearAndWait">
              <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>
          </RecoveryNode>
        </Parallel>
      </Sequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="WaitForClearance">
          <ClearEntireCostmap name="ClearLocal-Recovery" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobal-Recovery" service_name="global_costmap/clear_entirely_global_costmap"/>
          <Wait wait_duration="5"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>

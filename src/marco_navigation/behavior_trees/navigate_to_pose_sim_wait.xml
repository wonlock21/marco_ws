<!-- Humble BT nodes verified in nav2_behavior_tree/nav2_tree_nodes.xml.
     No Spin or BackUp recovery is present. Cancellation is handled by the
     NavigateToPose action server; CancelControl explicitly stops FollowPath. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1000" name="NavigateWaitRecovery">
      <PipelineSequence name="PlanAndFollow">
        <GoalUpdatedController>
          <RecoveryNode number_of_retries="1" name="PlanPath">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobal"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </GoalUpdatedController>
        <RecoveryNode number_of_retries="1000" name="FollowOrWait">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="ControlledWait">
            <CancelControl name="StopController"/>
            <ClearEntireCostmap name="ClearLocal"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="2"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="GoalOrWait">
        <GoalUpdated/>
        <Sequence name="WaitWithoutMotion">
          <CancelControl name="StopBeforeWait"/>
          <ClearEntireCostmap name="ClearLocalRecovery"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <Wait wait_duration="5"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>

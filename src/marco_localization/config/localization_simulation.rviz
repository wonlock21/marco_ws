Panels:
  - Class: rviz_common/Displays
    Name: Simulation Localization Test Displays
Visualization Manager:
  Class: ""
  Displays:
    - {Class: rviz_default_plugins/Grid, Name: Grid, Enabled: true, Cell Size: 1, Plane Cell Count: 30}
    - Class: rviz_default_plugins/Map
      Name: Simulation test map /map
      Enabled: true
      Topic: {Value: /map, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.75
    - Class: rviz_default_plugins/RobotModel
      Name: MarCO Simulation Robot
      Enabled: true
      Description Topic: {Value: /robot_description}
    - {Class: rviz_default_plugins/TF, Name: TF ownership chain, Enabled: true, Show Axes: true, Marker Scale: 0.35}
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan /scan (15 Hz simulation)
      Enabled: true
      Topic: {Value: /scan, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Queue Size: 1
      Decay Time: 0
      Style: Points
      Size (Pixels): 3
      Color: 0; 255; 110
    - Class: rviz_default_plugins/Odometry
      Name: Odometry input /odom
      Enabled: true
      Topic: {Value: /odom, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Keep: 200
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL PoseWithCovariance
      Enabled: true
      Topic: {Value: /amcl_pose, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Color: 255; 45; 0
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particle cloud
      Enabled: true
      Topic: {Value: /particle_cloud, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/Path
      Name: Ground truth path (cyan)
      Enabled: true
      Topic: {Value: /ground_truth/path, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/Path
      Name: AMCL estimated path (magenta)
      Enabled: true
      Topic: {Value: /amcl/path, Depth: 1, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.04
  Global Options: {Background Color: 35; 38; 45, Fixed Frame: map, Frame Rate: 30}
  Tools:
    - {Class: rviz_default_plugins/Interact}
    - {Class: rviz_default_plugins/MoveCamera}
    - {Class: rviz_default_plugins/Select}
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
    - {Class: rviz_default_plugins/FocusCamera}
  Views:
    Current: {Class: rviz_default_plugins/TopDownOrtho, Name: Simulation localization overview, Scale: 22}
Window Geometry: {Height: 900, Width: 1400}

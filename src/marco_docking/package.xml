<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marco_docking</name>
  <version>0.1.0</version>
  <description>
    Hassas yanasma: DockToStation action server.
    /lane/offset + /qr/detection → /cmd_vel_dock (twist_mux).
  </description>
  <maintainer email="marco@marmara.edu.tr">MarCO Yazilim Ekibi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>marco_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

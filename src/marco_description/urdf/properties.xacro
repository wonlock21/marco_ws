<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    MarCO otonom forklift - tum boyutsal parametreler.

    Bu dosya modelin tek gercek kaynagidir. Olcu guncellemesi gerektiginde
    yalnizca burasi degistirilir, diger xacro dosyalarina dokunulmaz.

    OLCULDU      : SolidWorks montajindan (STL, 28.07) dogrudan olculdu.
                   Parcalar montaj koordinatlarinda ihrac edildigi icin
                   konumlar mutlaktir. Olcum betikleri: scripts/stl_*.py
    DOGRULANMIS  : Proje Detay Raporu s.14 "Fiziksel Ozellikler" bolumunden.
    TAHMINI      : Rapordan turetilmis veya makul varsayim. Mekanik/elektronik
                   ekibinden gelen olculerle degistirilmelidir. Isaretlidir.

    CAD eksenleri (olcumle saptandi): x=genislik, y=yukseklik, z=uzunluk.
    Zemin duzlemi sarhos tekerlerin temas noktasi, CAD'de y=13.778 mm.
    Tahrik aksi CAD'de z=1171.95, govde orta ekseni x=365.40.

    ================== ILERI YON KARARI ==================
    +x (ileri) = GOVDE tarafi. Catallar ARKADA kalir.

    Mekanik ekibin adlandirmasiyla uyumlu ("On" isimli kapaklar govde
    ucunda) ve sartname madde 6 ile de tutarli: "yuku aldiktan sonra
    tasima, yuk hareket yonun tersi tarafta olacak sekilde devam
    etmelidir", yani yuk ve catallar arkada.

    DIKKAT: sartname madde 5 geri suruse zorunlu kiliyor. Yuk ALINIRKEN
    catalin paletin icine girmesi gerektigi icin arac -x yonunde
    (geri) hareket eder. Nav2 hem ileri hem geri surus yapmak zorunda;
    tek yonlu bir yapilandirma yeterli DEGIL.

    CAD -> URDF donusumu (mm cinsinden CAD degerleriyle):
        x_urdf = (z_cad - 1171.95) / 1000     ileri +
        y_urdf = (x_cad -  365.40) / 1000     sol +
        z_urdf = (y_cad -   13.778) / 1000    yukari +

    Bu donusumun sonuclari:
      tahrik tekeri x_cad=595.40 -> y=+0.230  SOL
      tahrik tekeri x_cad=135.40 -> y=-0.230  SAG
      catal ucu               -> x=-1.160
      govde on yuzu           -> x=+0.477
      govde arka yuzu         -> x=-0.475
    ================================================
  -->

  <!-- ==================== ARAC GOVDESI ==================== -->

  <!-- OLCULDU: z 11.6..1648.4 -> 1636.8 mm (catal ucundan govde arka yuzune) -->
  <xacro:property name="total_length"      value="1.637"/>
  <!-- OLCULDU: x 37.9..692.9 -> 655.0 mm -->
  <xacro:property name="body_width"        value="0.655"/>
  <!-- OLCULDU: zeminden en ust noktaya 544.5 mm -->
  <xacro:property name="total_height"      value="0.545"/>
  <!-- OLCULDU: en alcak sabit nokta catal alti, zeminden 21.6 mm -->
  <xacro:property name="ground_clearance"  value="0.022"/>

  <!-- OLCULDU: sasi Taban-1 ve yan paneller z 696.9..1646.9 -> 950.0 mm.
       Kalan uzunluk direk (mast, z~620) ve catallara ait. -->
  <xacro:property name="body_length"       value="0.950"/>

  <!-- ==================== TAHRIK TEKERLEKLERI ==================== -->

  <!-- OLCULDU: kusursuz silindir, yaricap 100.00 mm, dis kabuk sacilimi
       0.000 mm. Rapordaki 200 mm cap degeriyle birebir uyusuyor. -->
  <xacro:property name="wheel_radius"      value="0.100"/>
  <!-- OLCULDU: 50.00 mm -->
  <xacro:property name="wheel_width"       value="0.050"/>

  <!--
    OLCULDU: teker merkezleri x=135.40 ve x=595.40 -> 460.00 mm.

    Onceki TAHMINI deger 0.520 idi ve %13 hataliydi. Diferansiyel odometride
    aci hizi (v_sag - v_sol) / wheel_separation oldugu icin bu hata her donusu
    %11.5 eksik saydiriyordu: gercek 101.7 derecelik donus 90 derece olarak
    raporlanir. Sartnamenin +/-5 derece yon toleransi tek donuste asilirdi.
    Bu deger fiziksel model icindir. Encoder odometrisi base_driver.yaml'daki
    saha kalibrasyonlu etkin wheel_separation degerini kullanir.

    Tahrik uniteleri yayli: 4 adet 3 mm telli, Ø20 mm sarimli, 75 mm serbest
    boy helezon yay, akssin uzerinde. CAD'de teker zeminden 11.5 mm yukarida
    duruyor (yay serbest konumu); arac agirligi altinda basiyor.
  -->
  <xacro:property name="wheel_separation"  value="0.460"/>

  <!--
    OLCULDU: 0.475 m. base_link tahrik aksinin ortasina yerlesir (donme
    merkezi). Sasi CAD'de z 696.9..1646.9, aks z=1171.95 -> aks sasinin tam
    ortasinda, arka yuzden 475.05 mm ileride.
  -->
  <xacro:property name="axle_from_rear"    value="0.475"/>

  <!-- ==================== SARHOS TEKERLEKLER ==================== -->

  <!--
    OLCULDU: 4 adet donerli (swivel) sarhos teker. Zemin duzlemini bunlar
    tanimliyor (temas y=13.778, montajin en alt noktasi). Toplam yukseklik
    150.45 mm, zemin temasi donme ekseninin 31 mm gerisinde (trail).

    Boylamsal konumlar tahrik aksina gore -320.0 ve +340.0 mm. Hangisinin
    ileri oldugu ARAC YONU KARARINA bagli (asagidaki nota bakin), bu yuzden
    isaretler kesinlesmeden yazilmadi.
  -->
  <!-- TAHMINI: gorsel amacli; lokalizasyonu etkilemez -->
  <xacro:property name="caster_radius"     value="0.050"/>
  <xacro:property name="caster_width"      value="0.030"/>
  <!-- OLCULDU: aksa gore boylamsal mesafeler (isaret yon kararina bagli) -->
  <xacro:property name="caster_x_front"    value="0.340"/>
  <xacro:property name="caster_x_rear"     value="-0.320"/>
  <!-- OLCULDU: x=165.40 ve 565.40, govde ortasi 365.40 -> +/-200.0 mm.
       Tahrik tekerlerinden (+/-230) icte kaliyor. -->
  <xacro:property name="caster_y"          value="0.200"/>

  <!-- ==================== CATAL / LIFT ==================== -->

  <!-- OLCULDU: LdemirÇatal z 11.6..567.2 -> 555.58 mm -->
  <xacro:property name="fork_length"       value="0.556"/>

  <!--
    OLCULDU: catalin govdeye baglandigi (direk tarafindaki) ucu.
    CAD z=567.2 -> x=-0.605. Catallar buradan GERIYE dogru uzanir,
    uc noktasi x=-1.160. Govde arka yuzu x=-0.475 oldugundan catallar
    govdenin 130 mm gerisinden baslar (direk/mast bolgesi).
  -->
  <xacro:property name="fork_root_x"       value="-0.605"/>
  <!-- DOGRULANMIS: lift kaldirma yuksekligi 100 mm.
       CAD'deki dikey mil (Mil-1/-2) 400 mm kursa izin veriyor; sinir
       yazilim/limit switch tarafinda. -->
  <xacro:property name="fork_lift_stroke"  value="0.100"/>
  <!-- TAHMINI: L profilin sac kalinligi (STL'den kesitle ayrilmadi) -->
  <xacro:property name="fork_thickness"    value="0.020"/>
  <!-- OLCULDU: tek dis genisligi 100.00 mm -->
  <xacro:property name="fork_tine_width"   value="0.100"/>
  <!-- OLCULDU: dis merkezleri x=240.40 ve x=490.40 -> 250.00 mm -->
  <xacro:property name="fork_tine_spacing" value="0.250"/>

  <!-- ==================== SENSOR YERLESIMI ==================== -->

  <!--
    Orange Pi gercek donanim dogrulamasi: RPLIDAR A2M12'nin base_link'e
    gore konumu.

    laser_link dogru degilse SLAM haritasi ve AMCL lokalizasyonu kayar.

    KABUL (02.09, kullanici fiziksel olcumu): base_footprint'e gore LiDAR
    tarama merkezi x=+0.270, y=0.000, z=0.300 m.

    base_link, base_footprint'in 0.100 m ustundedir. Bu nedenle asagidaki
    base_link'e gore z degeri 0.200 m'dir; TF zincirinde zemine gore
    laser_link z=0.300 m olur. Saha testinde fiziksel on, LiDAR scan
    koordinatinda yaklasik -170..-179 derece goruldugu icin sensors.xacro
    icindeki base_link -> laser_link yaw duzeltmesi pi'dir.
  -->
  <xacro:property name="lidar_x"           value="0.270"/>
  <xacro:property name="lidar_y"           value="0.000"/>
  <xacro:property name="lidar_z"           value="0.200"/>

  <!--
    On ve arka IMX219 kameralari, zemindeki seridi gormek icin asagi egimli.
    pitch pozitif = asagi bakis. Arka kamera catal tarafina bakar ve yuk ALMA
    manevrasinda (geri surus) serit takibini o yapar; sartname madde 5.

    Bu degerler base_link'e GORE, yani zeminden yukseklik icin wheel_radius
    (0.100) eklenmeli.

    OLCULDU (on kamera): OnAltKapak-1 panelinde tek kamera acikligi var,
    60 x 54 mm, merkezi y=+0.3 mm (govde ortasi) ve zeminden 191.5 mm.
    Panelin dis yuzu x=+476.5 mm. Ayni panelde y=+/-138 mm'de bulunan
    70 x 90 mm iki acikligi kamera sanmayin, onlar sarhos tekerlerin
    onunu aciyor.
    -> camera_front_z = 0.1915 - 0.100 = 0.0915

    Onceki tahmin 0.350 (zeminden 0.450) idi; 26 cm sapma vardi. Kameranin
    zeminde gordugu bolge yukseklikle dogrudan olceklendigi icin serit
    takibi kalibrasyonu bu degere bagli.
  -->
  <xacro:property name="camera_front_x"     value="0.4765"/>
  <xacro:property name="camera_front_z"     value="0.0915"/>
  <!--
    TAHMINI (arka kamera): Arka-1 panelinde kamera acikligi YOK, yalnizca
    y=-130 mm / zeminden 373.5 mm'de 10 x 30 mm bir yarik var. Arka kamera
    henuz CAD'e islenmemis. Simetri varsayildi; mekanik ekip yerlestirince
    guncellenmeli.
  -->
  <xacro:property name="camera_rear_x"      value="-0.4765"/>
  <xacro:property name="camera_rear_z"      value="0.0915"/>
  <xacro:property name="camera_pitch"       value="0.7854"/>  <!-- 45 derece -->

  <!-- TAHMINI: IMU henuz donanimda YOK. Eklenirse konumu buradan ayarlanir.
       Donme merkezine yakin olmasi merkezkac ivme hatasini azaltir. -->
  <xacro:property name="imu_x"             value="0.000"/>
  <xacro:property name="imu_y"             value="0.000"/>
  <xacro:property name="imu_z"             value="0.150"/>

  <!-- ==================== KUTLE ==================== -->

  <!-- TAHMINI: raporda toplam kutle verilmemis. 3 mm celik sac sasi, aku,
       2 motor ve elektronik icin makul bir baslangic degeri.
       Sim dinamikleri icin onemli, gercek robotta tartilmali. -->
  <xacro:property name="body_mass"         value="70.0"/>
  <xacro:property name="wheel_mass"        value="2.5"/>
  <xacro:property name="caster_mass"       value="0.5"/>
  <xacro:property name="fork_mass"         value="8.0"/>

  <!-- ==================== KINEMATIK LIMITLER ==================== -->

  <!--
    DOGRULANMIS HESAP: motorlar 12 V'ta 80 RPM doner.
    80/60 tur/s * 2*pi*0.1 m = 0.838 m/s.
    Rapordaki 1.46 m/s degeri 24 V / 140 RPM icindir ve bu araca UYGULANMAZ.
  -->
  <xacro:property name="max_wheel_speed"   value="0.838"/>

</robot>

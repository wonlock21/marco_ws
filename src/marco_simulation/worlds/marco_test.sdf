<?xml version="1.0"?>
<sdf version="1.8">
  <world name="marco_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene><ambient>0.55 0.55 0.55</ambient><background>0.18 0.22 0.30</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><box><size>14 10 0.1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>14 10 0.1</size></box></geometry>
        <material><ambient>0.32 0.34 0.37 1</ambient><diffuse>0.42 0.44 0.47 1</diffuse></material></visual>
      <pose>0 0 -0.05 0 0 0</pose>
    </link></model>

    <!-- Four perimeter walls -->
    <model name="walls"><static>true</static>
      <link name="north"><pose>0 5 0.75 0 0 0</pose><collision name="c"><geometry><box><size>14 0.15 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>14 0.15 1.5</size></box></geometry><material><diffuse>0.75 0.78 0.82 1</diffuse></material></visual></link>
      <link name="south"><pose>0 -5 0.75 0 0 0</pose><collision name="c"><geometry><box><size>14 0.15 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>14 0.15 1.5</size></box></geometry><material><diffuse>0.75 0.78 0.82 1</diffuse></material></visual></link>
      <link name="east"><pose>7 0 0.75 0 0 0</pose><collision name="c"><geometry><box><size>0.15 10 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 10 1.5</size></box></geometry><material><diffuse>0.75 0.78 0.82 1</diffuse></material></visual></link>
      <link name="west"><pose>-7 0 0.75 0 0 0</pose><collision name="c"><geometry><box><size>0.15 10 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 10 1.5</size></box></geometry><material><diffuse>0.75 0.78 0.82 1</diffuse></material></visual></link>
    </model>

    <!-- Light obstacles, outside the initial driving lane but visible to lidar/camera. -->
    <model name="red_box"><static>true</static><pose>3.0 1.6 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.8 0.8 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 0.8 0.9</size></box></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.95 0.08 0.08 1</diffuse></material></visual></link></model>
    <model name="green_box"><static>true</static><pose>4.5 -1.8 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.7 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.7 1.2</size></box></geometry><material><ambient>0.05 0.75 0.15 1</ambient><diffuse>0.08 0.95 0.18 1</diffuse></material></visual></link></model>
    <model name="blue_box"><static>true</static><pose>-2.5 2.3 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.0 0.6 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.6 0.7</size></box></geometry><material><ambient>0.05 0.2 0.85 1</ambient><diffuse>0.08 0.3 1 1</diffuse></material></visual></link></model>
    <model name="yellow_cylinder"><static>true</static><pose>-3.5 -2.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry><material><ambient>0.9 0.65 0.02 1</ambient><diffuse>1 0.75 0.02 1</diffuse></material></visual></link></model>

    <!-- Phase 9 simulation-only approach lane and real decodable QR texture. -->
    <model name="phase9_lane"><static>true</static><pose>1.5 0 0.006 0 0 0</pose>
      <link name="link"><visual name="yellow_lane"><geometry><box><size>3.0 0.10 0.01</size></box></geometry>
        <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material>
      </visual></link>
    </model>
    <include><uri>model://phase9_qr_geometry</uri>
      <name>phase9_qr</name><pose>1.05 0 0.013 0 0 0</pose>
    </include>
  </world>
</sdf>

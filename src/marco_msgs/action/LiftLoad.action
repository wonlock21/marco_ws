# Lift hardware abstraction. A simulation-only server may implement this action,
# but must identify itself as test-only in logs and parameters.
uint8 COMMAND_PICKUP=0
uint8 COMMAND_DROPOFF=1
uint8 command
string station_id
float32 timeout
---
bool success
uint8 RESULT_OK=0
uint8 RESULT_TIMEOUT=1
uint8 RESULT_LIMIT_SWITCH=2
uint8 RESULT_HARDWARE_FAULT=3
uint8 RESULT_ABORTED=4
uint8 result_code
string message
---
string phase
float32 position
